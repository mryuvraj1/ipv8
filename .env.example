# Copy to .env and edit. The Go program does not load .env files automatically.
IPV8_ADDR=127.0.0.1:8080
IPV8_DATA=./data/ipv8.json
IPV8_COOKIE_SECURE=false

# For Cloudflare Tunnel deployments, set both to the public HTTPS origin.
# Leave empty for local development. The panel and API currently share one origin.
IPV8_PUBLIC_URL=
IPV8_API_URL=

# Cloudflare Tunnel only; keep in a root-readable tunnel credential file and
# never export this variable to the IPv8 process, agent, or frontend.
# CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN

# Used only for `bootstrap-admin`; remove from the environment immediately after.
IPV8_ADMIN_EMAIL=admin@example.invalid
IPV8_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_14_CHARACTERS
