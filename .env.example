# Copy to .env and edit. The Go program does not load .env files automatically.
IPV8_ADDR=127.0.0.1:8080
IPV8_DATA=./data/ipv8.json
IPV8_COOKIE_SECURE=false

# Used only for `bootstrap-admin`; remove from the environment immediately after.
IPV8_ADMIN_EMAIL=admin@example.invalid
IPV8_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_14_CHARACTERS
